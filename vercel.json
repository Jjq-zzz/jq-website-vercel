{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 240
    },
    "api/process.mjs": {
      "maxDuration": 240,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "course-notes"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
