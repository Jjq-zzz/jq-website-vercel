{
  "name": "course-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "课件批量转笔记：整门课的 PPT/PDF 一键变成结构化复习笔记库",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "node scripts/build.mjs",
    "start": "node server/index.js",
    "set-password": "node scripts/set-password.mjs",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/ai.test.js tests/parsers.test.js tests/formats.test.js tests/byok.test.js",
    "test:browser": "node tests/browser-runner.mjs",
    "fixtures": "python scripts/make_fixtures.py",
    "cf:login": "wrangler login",
    "cf:dev": "wrangler dev",
    "cf:check": "wrangler deploy --dry-run --containers-rollout=none --outdir .tmp-build/cloudflare",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:migrate": "wrangler d1 migrations apply course-notes --remote",
    "cf:logs": "wrangler tail",
    "cf:parser": "node cloudflare/parser/server.mjs",
    "test:cloudflare": "node scripts/test-cloudflare.mjs",
    "cf:export": "node scripts/export-cloudflare.mjs",
    "cf:password": "node scripts/cloudflare-password.mjs",
    "vercel:dev": "vercel --global-config .vercel/auth dev",
    "vercel:login": "vercel --global-config .vercel/auth login",
    "vercel:deploy": "vercel --global-config .vercel/auth --prod",
    "vercel:migrate": "node scripts/migrate-vercel.mjs",
    "vercel:link": "vercel --global-config .vercel/auth link",
    "vercel:env": "vercel --global-config .vercel/auth env pull .env.local",
    "vercel:build": "node scripts/migrate-vercel.mjs && npm run build",
    "test:vercel": "node scripts/test-vercel.mjs",
    "vercel:export": "node scripts/export-cloudflare.mjs vercel/private",
    "vercel:import": "node scripts/vercel-data.mjs import",
    "vercel:password": "node scripts/vercel-data.mjs password"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@christophervr/ole2": "^0.13.0",
    "@cloudflare/containers": "^0.3.7",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "@vercel/queue": "^0.10.0",
    "adm-zip": "^0.6.1",
    "antd": "^5.27.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "officeparser": "^8.2.0",
    "openai": "^4.104.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^6.30.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.64.1",
    "selfsigned": "^5.5.0",
    "vercel": "^65.8.0",
    "vite": "^6.1.0",
    "wrangler": "^4.156.0"
  }
}
